# Copia estos nombres a Vercel -> Project Settings -> Environment Variables (NO subas un .env real a GitHub)
KINC_SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
# KINC_DEBUG se pone en False automaticamente en Vercel
# KINC_ALLOWED_HOSTS: no hace falta en Vercel (se agrega .vercel.app); usalo si tienes dominio propio
DATABASE_URL=postgresql://usuario:clave@host/basedatos?sslmode=require
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://<cuenta>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
